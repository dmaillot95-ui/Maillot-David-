    },
    "PROOF_SYNTHESIST": {
      "mission": "merge surviving lemmas into the shortest rigorous proof chain and expose the unique residual",
      "preferred_workers": ["gemma9b", "llama3b"]
    },
    "POLYMORPHIC_MATHEMATICIAN": {
      "mission": "switch among mathematical identities according to the active bottleneck while preserving evidence rules",
      "preferred_workers": ["llama3b", "gemma9b", "gemma2b"],
      "routing_rule": "choose specialist persona from active lock; do not keep a fixed persona when the residual changes"
    }
