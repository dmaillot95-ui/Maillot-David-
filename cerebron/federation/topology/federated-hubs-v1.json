{
  "schema": "cerebron-federated-hubs-v1",
  "version": 1,
  "spend_limit_eur": 0,
  "physical_concurrency_cap": 20,
  "logical_shards_per_hub": 20,
  "tribes": [
    {
      "tribe_id": "T01-PROOF",
      "mission": "formal proof and invariant discovery",
      "hubs": ["T01-H01","T01-H02","T01-H03","T01-H04"]
    },
    {
      "tribe_id": "T02-CONGRUENCE",
      "mission": "congruences, valuations and divisibility",
      "hubs": ["T02-H01","T02-H02","T02-H03","T02-H04"]
    },
    {
      "tribe_id": "T03-COMPUTE",
      "mission": "deterministic computation and symbolic checking",
      "hubs": ["T03-H01","T03-H02","T03-H03","T03-H04"]
    },
    {
      "tribe_id": "T04-REDTEAM",
      "mission": "counterexamples, hostile audit and contradiction search",
      "hubs": ["T04-H01","T04-H02","T04-H03","T04-H04"]
    },
    {
      "tribe_id": "T05-FORMALIZE",
      "mission": "replication, synthesis and formalization",
      "hubs": ["T05-H01","T05-H02","T05-H03","T05-H04"]
    }
  ],
  "routing_policy": {
    "address_space": "tribe/hub/shard",
    "global_queue": true,
    "deduplicate_task_ids": true,
    "provider_scoring": "cerebron/federation/routing/provider_router.py",
    "provider_runtime_memory": "cerebron/federation/state/provider-runtime.json",
    "paid_fallback": false,
    "floot_allowed": false
  }
}
