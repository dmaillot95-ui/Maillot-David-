  "team_formation_engine": {
    "trigger": "classify active residual into subject; instantiate matching team template",
    "minimum_team_functions": ["creator", "independent_checker", "falsifier", "formal_auditor", "synthesizer"],
    "cross_family_rule": "at least one critical producer and one critical auditor must come from different model families",
    "polymorphic_rule": "workers may change specialist identity between waves or within a campaign when the mathematical lock changes",
    "anti_groupthink_rule": "do not assign all proving, auditing and judging functions to one family",
    "reconfiguration_rule": "if a residual changes category, dissolve the old specialist team and instantiate the new subject team while preserving artifacts and checkpoints",
    "evidence_rule": "team consensus never upgrades an unproved claim; only audited derivation does"
  },
